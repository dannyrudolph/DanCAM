# .sops.yaml — which age recipient may decrypt each secrets file.
#
# YOU DO NOT WRITE THIS BY HAND. `bash scripts/secrets.sh init` generates it
# from your two age keys, and `rotate` rewrites it after a key swap. This
# template just shows the shape it will have.
#
# The recipients below are age PUBLIC keys — safe to commit. dev and prod use
# SEPARATE recipients so the dev key cannot decrypt prod (or vice versa).
creation_rules:
  - path_regex: secrets/prod\.enc\.env$
    age: "age1PROD_PUBLIC_RECIPIENT_FILLED_IN_BY_INIT"
  - path_regex: secrets/dev\.enc\.env$
    age: "age1DEV_PUBLIC_RECIPIENT_FILLED_IN_BY_INIT"
