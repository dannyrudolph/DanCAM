# Deploy workflow template — decrypt prod secrets with SOPS at deploy time and
# push them to your host. Copy to .github/workflows/deploy.yml and fill in the
# {{PLACEHOLDERS}}.
#
# Required GitHub Actions secrets (Settings → Secrets and variables → Actions):
#   SOPS_AGE_KEY_PROD   the PROD age PRIVATE key (contents of
#                       ~/.config/sops/age/<project>-prod.txt). This is the ONLY
#                       app-decryption key CI holds — it cannot decrypt dev.
#   plus whatever deploy credential your host needs (e.g. CLOUDFLARE_API_TOKEN).
#
# Set the age key once from your machine:
#   gh secret set SOPS_AGE_KEY_PROD < ~/.config/sops/age/<project>-prod.txt
name: Deploy
on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - name: Install sops + age
        run: |
          curl -sSL -o /usr/local/bin/sops https://github.com/getsops/sops/releases/latest/download/sops-v3.9.4.linux.amd64
          chmod +x /usr/local/bin/sops
          sudo apt-get update && sudo apt-get install -y age

      # Keyless guard: fail before decrypting if the prod manifest is incomplete.
      - name: Validate secrets manifest
        run: bash scripts/secrets.sh validate

      # {{ set up your language/runtime here, e.g. actions/setup-node + install }}

      # Build with the prod secrets injected (bakes in any PUBLIC_ build vars).
      - name: Build
        env:
          SOPS_AGE_KEY: ${{ secrets.SOPS_AGE_KEY_PROD }}
        run: sops exec-env secrets/prod.enc.env '{{ BUILD_COMMAND }}'

      # Deploy the built artifact to your host.
      - name: Deploy
        env:
          # {{ HOST_DEPLOY_CREDENTIAL }}: ${{ secrets.{{ HOST_DEPLOY_CREDENTIAL }} }}
          SOPS_AGE_KEY: ${{ secrets.SOPS_AGE_KEY_PROD }}
        run: '{{ DEPLOY_COMMAND }}'

      # Sync runtime secrets into the host from the encrypted source (not a
      # dashboard). Uses SECRETS_DEPLOY_SYNC / SECRETS_DEPLOY_FORMAT from
      # .secretsrc — see optional/secrets/templates/deploy/<host>.md.
      - name: Sync runtime secrets
        env:
          SOPS_AGE_KEY: ${{ secrets.SOPS_AGE_KEY_PROD }}
        run: bash scripts/secrets.sh push prod
