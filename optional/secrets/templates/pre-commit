#!/bin/sh
# Pre-commit guard for the SOPS secrets scheme.
#
# The ENCRYPTED secrets/*.enc.env files ARE meant to be committed. Their
# decrypted forms (secrets/*.dec.env, .dev.vars) and the age PRIVATE keys are
# NOT — committing one leaks every secret it holds. This hook refuses any commit
# that stages such a file and tells you how to re-encrypt.
#
# Activate once per clone with:  git config core.hooksPath .githooks
# Bypass in a genuine emergency only:  git commit --no-verify

blocked=""

# Only look at what THIS commit adds or modifies.
staged=$(git diff --cached --name-only --diff-filter=AM)

# Iterate the newline-separated list. Repo paths here never contain spaces.
# shellcheck disable=SC2086
for f in $staged; do
  case "$f" in
    .env.example) continue ;;  # the names-only template is safe to commit
    *.dec.env|.dev.vars|.env|.env.*|*.agekey|keys.txt|age-key.txt)
      blocked="$blocked $f"; continue ;;
  esac
  # Catch an age private key pasted into any other staged file (filename-agnostic).
  # Require the key BODY (40+ trailing Bech32 chars), not just the "AGE-SECRET-KEY-1"
  # marker: this hook, its tests, SECRETS-PIPELINE.md, and scripts/secrets.sh all
  # mention the bare marker as prose and would otherwise flag themselves.
  if git show ":$f" 2>/dev/null | grep -qE 'AGE-SECRET-KEY-1[0-9A-Z]{40,}'; then
    blocked="$blocked $f"
  fi
done

if [ -n "$blocked" ]; then
  echo "pre-commit: BLOCKED — refusing to commit plaintext secrets / private keys:"
  # shellcheck disable=SC2086
  for f in $blocked; do echo "    - $f"; done
  cat <<'EOF'

These must never be committed. To fix:
  • Re-encrypt an edited file and delete its plaintext:
        bash scripts/secrets.sh encrypt dev      # or: prod
  • Remove any stray decrypted files:
        bash scripts/secrets.sh clean
  • Or just unstage it:
        git restore --staged <file>

The encrypted secrets/<env>.enc.env files ARE meant to be committed.
Bypass (emergencies only): git commit --no-verify
EOF
  exit 1
fi

# Secondary, KEYLESS guard: if the encrypted manifest exists, confirm both files
# still declare every variable named in .env.example (SOPS keeps dotenv names in
# cleartext, so this needs no age key). Mirrors the CI deploy guard.
if [ -f .sops.yaml ] && [ -f secrets/dev.enc.env ] && [ -f secrets/prod.enc.env ]; then
  if ! bash scripts/secrets.sh validate >/dev/null 2>&1; then
    echo "pre-commit: secrets manifest is incomplete. Run: bash scripts/secrets.sh validate"
    echo "  Fix the mismatch, then commit again."
    exit 1
  fi
fi

# Non-blocking reminder: decrypted plaintext lying around (gitignored, so it
# won't be staged, but you don't want it sitting on disk either).
for f in secrets/*.dec.env; do
  [ -e "$f" ] || continue
  echo "pre-commit: note — decrypted $f is present. Re-encrypt (bash scripts/secrets.sh encrypt <env>) or remove it (bash scripts/secrets.sh clean)."
done

exit 0
